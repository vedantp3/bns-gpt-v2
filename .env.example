# ─────────────────────────────────────────────────
#  BNS-GPT v2 — Environment Variables Template
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────

# Groq API (https://console.groq.com)
GROQ_API_KEY=

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI: <backend URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_KEY=

# Session signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the Next.js frontend runs. An https:// URL switches the session cookie to SameSite=None; Secure.
FRONTEND_URL=http://localhost:3000

# Server port (optional, defaults to 7860)
PORT=7860

# ── Optional tuning ──────────────────────────────────
# Reasoning effort for gpt-oss models: low (fastest), medium, high
REASONING_EFFORT=low
# Model tried when the primary model fails before answering
FALLBACK_MODEL=openai/gpt-oss-120b
# Model used for non-English answers (20b often ignores the requested language)
MULTILINGUAL_MODEL=openai/gpt-oss-120b
# Questions allowed per user per minute
RATE_LIMIT_PER_MINUTE=20
